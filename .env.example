# docker-compose reads a .env beside docker-compose.yml. Copy this to .env to override a default;
# every value shown is the default already, and .env is gitignored. See docs/CONFIGURATION.md.

# Secrets. The defaults are for local runs only.
OPERATOR_API_KEY=local-operator-key
PAYMENTS_SERVICE_TOKEN=local-development-token

# Admission. Off for the load harness, whose requests all come from one address.
RATE_LIMIT_ENABLED=false

# Background jobs, each switchable so a run can price it.
OUTBOX_ENABLED=true
SWEEP_ENABLED=true
ORDER_EXPIRY_SWEEP_ENABLED=true
RECONCILER_ENABLED=true
RECONCILER_EVERYWHERE=false
RECONCILER_MIN_AGE=00:05:00
RECONCILER_POLL=00:01:00

# The hold cap's lock.
HOLD_CAP_LOCK=Redis
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_LOCK_COOLDOWN=00:00:01

# The simulated gateway behind the Payments service.
PAYMENTS_TIMEOUT_RATE=0
PAYMENTS_LOST_REQUEST_RATE=0.5

# Observability. OTEL_ENDPOINT=http://lgtm:4317 with --profile telemetry turns telemetry on.
ENCORE_LOG_LEVEL=Information
OTEL_ENDPOINT=
