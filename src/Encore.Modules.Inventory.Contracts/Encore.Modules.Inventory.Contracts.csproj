<Project Sdk="Microsoft.NET.Sdk">

  <!-- Inventory's public face: the only thing another module may know about it.
       No packages and no project references, so a consumer cannot pick up EF Core,
       Redis or the domain through it (ENCORE001-003 in Directory.Build.targets). -->
  <PropertyGroup>
    <EncoreZeroDependency>true</EncoreZeroDependency>
  </PropertyGroup>

</Project>
