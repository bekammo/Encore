<Project Sdk="Microsoft.NET.Sdk">

  <!-- Flat module: Endpoints / Data / Models, no layering. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Other modules are reached only through their .Contracts assemblies. -->
    <ProjectReference Include="..\Encore.Modules.Inventory.Contracts\Encore.Modules.Inventory.Contracts.csproj" />

    <ProjectReference Include="..\Encore.Modules.Catalog.Contracts\Encore.Modules.Catalog.Contracts.csproj" />

    <ProjectReference Include="..\Encore.Modules.Payments.Contracts\Encore.Modules.Payments.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Encore.Modules.Orders.UnitTests" />
    <InternalsVisibleTo Include="Encore.Modules.Orders.IntegrationTests" />
  </ItemGroup>

  <!-- IHttpClientFactory comes from the ASP.NET Core shared framework; referencing
       Microsoft.Extensions.Http explicitly is an NU1510 error. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Shared startup migrator and Npgsql wiring. It names no module. -->
  <ItemGroup>
    <ProjectReference Include="..\Encore.Modules.Shared.Persistence\Encore.Modules.Shared.Persistence.csproj" />
  </ItemGroup>

</Project>
