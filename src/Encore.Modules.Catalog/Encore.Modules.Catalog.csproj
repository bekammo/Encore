<Project Sdk="Microsoft.NET.Sdk">

  <!-- Flat CRUD module. Endpoints / Data / Models, no layering ceremony.
       Infrastructure packages sit right next to the endpoints on purpose —
       this module has no hard problem in it, so it gets no abstraction. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The in-process pricing adapter is internal so that the registration in
       CatalogModule stays the only place the implementation is chosen. Its
       tests still need to construct it, and proving the projection against real
       Postgres beats inferring it from a consumer's behaviour. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Encore.Modules.Catalog.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Encore.Shared\Encore.Shared.csproj" />

    <!-- Catalog's public face, and the assembly its own in-process adapter
         implements. Referencing it here is what lets CatalogModule register
         that adapter without any consumer learning the type. -->
    <ProjectReference Include="..\Encore.Modules.Catalog.Contracts\Encore.Modules.Catalog.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
