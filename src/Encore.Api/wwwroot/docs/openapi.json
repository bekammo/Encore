{
  "openapi": "3.1.0",
  "info": {
    "title": "Encore",
    "version": "0.1.0",
    "description": "Event ticketing, as a modular monolith. Four modules behind one ASP.NET Core host.\n\n**Actions, not resources.** The seat routes are `/hold`, `/release` and `/purchase` rather than a `/holds` collection: a hold is not an entity, it is two fields on the seat row, so it gets no URI of its own. All three are idempotent, which is what makes retrying a POST safe.\n\n**Branch on `reason`, not on status.** Every refusal about the state of the world is `409` with a machine-readable `reason` and a `retriable` flag. Only an addressed thing that is not there is `404`. A request that is wrong on its own terms is `400`. The statuses carry the class of failure; `reason` carries which one.\n\n**`X-Client-Id` is a claimed identity, not authentication.** Anyone can change it and reset their own hold cap. It stands in for the Identity module, which does not exist yet, which is also why no route returns 401 or 403.\n\nThis document is hand-maintained and was verified against a running instance. `Encore.Api` holds zero NuGet packages by design (`DECISIONS.md` 002, 014, 036), so nothing generates this from endpoint metadata — see `DECISIONS.md` 049 for what that costs and what would change it."
  },
  "servers": [
    { "url": "/", "description": "Whichever instance served this page — 5107 from dotnet run, 8080 from the container." }
  ],
  "tags": [
    { "name": "health", "description": "Liveness." },
    { "name": "catalog", "description": "Venues and events. Read-mostly CRUD, public, no client identity." },
    { "name": "inventory", "description": "Seats. The contended module: hold, release, purchase." },
    { "name": "orders", "description": "Checkout. Prices through Catalog, holds through Inventory, charges through Payments." },
    { "name": "payments", "description": "Read-only. Orders drives payment, because Orders knows what is owed." }
  ],
  "components": {
    "securitySchemes": {
      "ClientId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Client-Id",
        "description": "A GUID identifying the calling client. NOT authentication — it is unverified and anyone may change it. Paste any GUID here to try the seat, order and payment routes."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details. Module refusals add `reason` and `retriable`; framework refusals (404 for an unmatched route, 405, 415, a body that will not bind) carry only the standard members.",
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "reason": { "type": "string", "description": "Machine-readable refusal code. Branch on this." },
          "retriable": { "type": "boolean", "description": "Whether the identical request could plausibly succeed later." },
          "limit": { "type": "integer", "description": "Present on hold_cap_reached and too_many_seats." },
          "traceId": { "type": "string" }
        },
        "required": ["type", "title", "status"]
      },
      "CreateVenueRequest": {
        "type": "object",
        "required": ["name", "address", "capacity"],
        "properties": {
          "name": { "type": "string", "maxLength": 200 },
          "address": { "type": "string", "maxLength": 500 },
          "capacity": { "type": "integer", "minimum": 1 }
        }
      },
      "VenueResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "address": { "type": "string" },
          "capacity": { "type": "integer" }
        }
      },
      "CreateEventRequest": {
        "type": "object",
        "required": ["venueId", "name", "startsAt", "price", "currency"],
        "properties": {
          "venueId": { "type": "string", "format": "uuid", "description": "Must already exist." },
          "name": { "type": "string", "maxLength": 200 },
          "startsAt": { "type": "string", "format": "date-time", "description": "Must carry a timezone. Stored and returned as UTC." },
          "onSaleAt": { "type": ["string", "null"], "format": "date-time", "description": "When tickets become orderable. Null means immediately. Must carry a timezone when supplied." },
          "price": { "type": "number", "description": "What one seat costs." },
          "currency": { "type": "string", "description": "ISO 4217 code.", "example": "GBP" }
        }
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "venueId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "startsAt": { "type": "string", "format": "date-time" },
          "onSaleAt": { "type": ["string", "null"], "format": "date-time" },
          "price": { "type": "number" },
          "currency": { "type": "string" }
        }
      },
      "CreateSeatMapRequest": {
        "type": "object",
        "required": ["count"],
        "properties": {
          "count": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      },
      "CreateSeatMapResponse": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "format": "uuid" },
          "seatIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "description": "In creation order." }
        }
      },
      "HeldSeatResponse": {
        "type": "object",
        "properties": {
          "seatId": { "type": "string", "format": "uuid" },
          "holdExpiresAt": { "type": "string", "format": "date-time", "description": "Five minutes out. The duration is owned by the domain; a caller never supplies it." }
        }
      },
      "SeatActionResponse": {
        "type": "object",
        "properties": {
          "seatId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["available", "sold"] }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": ["eventId", "seatIds"],
        "properties": {
          "eventId": { "type": "string", "format": "uuid" },
          "seatIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "description": "At most four, the per-client hold cap. A repeated id is refused, not de-duplicated." }
        }
      },
      "OrderLineResponse": {
        "type": "object",
        "properties": {
          "seatId": { "type": "string", "format": "uuid" },
          "unitPrice": { "type": "number" },
          "currency": { "type": "string" }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "expired", "failed", "awaiting_capture"], "description": "awaiting_capture is non-terminal and is resolved by the next confirm rather than by a background job." },
          "placedAt": { "type": "string", "format": "date-time" },
          "holdsExpireAt": { "type": ["string", "null"], "format": "date-time", "description": "Null once the order closes." },
          "closedAt": { "type": ["string", "null"], "format": "date-time" },
          "total": { "type": "number" },
          "currency": { "type": "string" },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/OrderLineResponse" } }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "orderId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "authorized", "captured", "declined", "timed_out", "voided"] },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "gatewayReference": { "type": ["string", "null"] },
          "attemptedAt": { "type": "string", "format": "date-time" },
          "resolvedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadClientId": {
        "description": "The X-Client-Id header is missing or is not a GUID. No `reason`: the request is malformed rather than refused.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "parameters": {
      "EventId": { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "SeatId": { "name": "seatId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "OrderId": { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness.",
        "description": "The host's own route, not a framework health check. A 200 means the pipeline is serving and the migrators have finished, because they run as IHostedLifecycleService before Kestrel opens the socket.",
        "responses": {
          "200": {
            "description": "Serving.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } } } }
          }
        }
      }
    },
    "/catalog/venues": {
      "post": {
        "tags": ["catalog"],
        "summary": "Creates a venue and returns it.",
        "description": "Operator-facing. Ids are generated here, not supplied.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateVenueRequest" } } } },
        "responses": {
          "201": {
            "description": "Created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenueResponse" } } }
          },
          "400": {
            "description": "reason: invalid_name, invalid_address, invalid_capacity.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      },
      "get": {
        "tags": ["catalog"],
        "summary": "Lists every venue.",
        "responses": {
          "200": {
            "description": "All venues.",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/VenueResponse" } } } }
          }
        }
      }
    },
    "/catalog/venues/{venueId}": {
      "get": {
        "tags": ["catalog"],
        "summary": "Reads one venue.",
        "parameters": [{ "name": "venueId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "The venue.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenueResponse" } } } },
          "404": { "description": "reason: venue_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/catalog/events": {
      "post": {
        "tags": ["catalog"],
        "summary": "Creates an event at an existing venue and returns it.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateEventRequest" } } } },
        "responses": {
          "201": { "description": "Created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventResponse" } } } },
          "400": {
            "description": "reason: invalid_name, invalid_price, invalid_currency, ambiguous_timestamp. The last one is a startsAt or onSaleAt with no timezone.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "409": { "description": "reason: venue_not_found. Create the venue before the event.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      },
      "get": {
        "tags": ["catalog"],
        "summary": "Lists every event, soonest first.",
        "responses": {
          "200": { "description": "All events.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EventResponse" } } } } }
        }
      }
    },
    "/catalog/events/{eventId}": {
      "get": {
        "tags": ["catalog"],
        "summary": "Reads one event.",
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "responses": {
          "200": { "description": "The event.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventResponse" } } } },
          "404": { "description": "reason: event_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/events/{eventId}/seats": {
      "post": {
        "tags": ["inventory"],
        "summary": "Creates an event's seats and returns their ids.",
        "description": "Operator-facing, and the only seat route with no client identity: creating a seat map is not something a customer does. Returns 201 with no Location header, because there is no GET for a seat map and a Location pointing at nothing is worse than none.",
        "parameters": [{ "$ref": "#/components/parameters/EventId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSeatMapRequest" } } } },
        "responses": {
          "201": { "description": "The seats now exist.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSeatMapResponse" } } } },
          "400": { "description": "An empty event id, or a count outside 1..10000. No `reason` member on this one.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/events/{eventId}/seats/{seatId}/hold": {
      "post": {
        "tags": ["inventory"],
        "summary": "Holds a seat for the calling client for five minutes.",
        "description": "Idempotent: the same client re-holding gets the same expiry back and raises no second event. A seat whose hold has lapsed is available again on this path whatever the stored status says, so an expired hold is reclaimed here rather than by waiting for a sweep.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EventId" }, { "$ref": "#/components/parameters/SeatId" }],
        "responses": {
          "200": { "description": "Held.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HeldSeatResponse" } } } },
          "400": { "$ref": "#/components/responses/BadClientId" },
          "404": { "description": "reason: seat_not_found. Also the answer for a seat that exists under a different event, so seat ids cannot be discovered by asking.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": {
            "description": "reason: already_held (retriable), already_sold (not), hold_cap_reached (retriable, carries `limit`), lost_race (retriable), concurrent_request_in_flight (retriable).",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/events/{eventId}/seats/{seatId}/release": {
      "post": {
        "tags": ["inventory"],
        "summary": "Gives a held seat back.",
        "description": "Only the holding client may release. Releasing a seat that is already available is a no-op success.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EventId" }, { "$ref": "#/components/parameters/SeatId" }],
        "responses": {
          "200": { "description": "Released, or already available.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SeatActionResponse" } } } },
          "400": { "$ref": "#/components/responses/BadClientId" },
          "404": { "description": "reason: seat_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "reason: already_sold (sold is terminal), not_the_holder, lost_race.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/events/{eventId}/seats/{seatId}/purchase": {
      "post": {
        "tags": ["inventory"],
        "summary": "Converts the calling client's live hold into a sale.",
        "description": "Requires a live, unexpired hold by the same client. There is no selling an available seat outright. Idempotent: re-buying a seat you already own returns 200.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EventId" }, { "$ref": "#/components/parameters/SeatId" }],
        "responses": {
          "200": { "description": "Sold.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SeatActionResponse" } } } },
          "400": { "$ref": "#/components/responses/BadClientId" },
          "404": { "description": "reason: seat_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "reason: already_sold, not_the_holder, hold_expired (retriable), no_active_hold (retriable), lost_race (retriable).", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": ["orders"],
        "summary": "Opens a checkout: prices the event, holds every seat, returns the order.",
        "description": "A partial checkout writes nothing and releases nothing it did not take. One open checkout per client per event, enforced by a partial unique index rather than by a read-then-write.",
        "security": [{ "ClientId": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutRequest" } } } },
        "responses": {
          "201": { "description": "Order opened, every seat held.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } },
          "400": { "description": "Missing or malformed X-Client-Id, or reason: no_seats, too_many_seats (carries `limit`), duplicate_seat.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": {
            "description": "reason: event_not_found, not_on_sale, checkout_already_open, seats_unavailable (carries `seats`), already_held, already_sold, hold_cap_reached, concurrent_request_in_flight, lost_race.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": ["orders"],
        "summary": "Reads one of the calling client's orders.",
        "description": "Another client's order is 404, not 403 — there is no authorisation system to produce a 403.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
        "responses": {
          "200": { "description": "The order.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } },
          "400": { "$ref": "#/components/responses/BadClientId" },
          "404": { "description": "reason: order_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/orders/{orderId}/confirm": {
      "post": {
        "tags": ["orders"],
        "summary": "Authorises the total, sells the seats, then captures.",
        "description": "In that order, because a sold seat is terminal and money is the one of the two that can be given back. Any path that does not end in every seat sold voids the authorisation, so a customer is never charged for an order they did not get. A gateway timeout leaves the order awaiting_capture, which the next confirm resolves.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
        "responses": {
          "200": { "description": "Confirmed. Re-confirming a confirmed order returns it unchanged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } },
          "400": { "$ref": "#/components/responses/BadClientId" },
          "404": { "description": "reason: order_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": {
            "description": "reason: order_not_pending, holds_expired, payment_declined, payment_timed_out, seats_unavailable, order_failed.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/orders/{orderId}/cancel": {
      "post": {
        "tags": ["orders"],
        "summary": "Ends the order because the customer said so, releasing the seats.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
        "responses": {
          "200": { "description": "Cancelled, seats released.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } },
          "400": { "$ref": "#/components/responses/BadClientId" },
          "404": { "description": "reason: order_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "reason: order_not_pending. A confirmed order cannot be changed.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/payments/{paymentId}": {
      "get": {
        "tags": ["payments"],
        "summary": "Reads back what happened to a payment.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "name": "paymentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "The attempt.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentResponse" } } } },
          "400": { "$ref": "#/components/responses/BadClientId" },
          "404": { "description": "reason: payment_not_found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/payments": {
      "get": {
        "tags": ["payments"],
        "summary": "Lists the attempts against one order.",
        "description": "Read-only on purpose: Orders drives payment, because Orders is the thing that knows what is owed. There is no POST here.",
        "security": [{ "ClientId": [] }],
        "parameters": [{ "name": "orderId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Every attempt against that order, including superseded ones.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PaymentResponse" } } } } },
          "400": { "$ref": "#/components/responses/BadClientId" }
        }
      }
    }
  }
}
