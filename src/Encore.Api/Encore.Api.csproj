<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host: composes the modules through their Add*/Map* seams and nothing else. -->

  <!-- No packages of its own (ENCORE001). ASP.NET Core and EF Core arriving through the
       Web SDK and the modules is what a host is for. -->
  <PropertyGroup>
    <EncoreNoDirectPackages>true</EncoreNoDirectPackages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Encore.Modules.Catalog\Encore.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Encore.Modules.Inventory\Encore.Modules.Inventory.csproj" />
    <ProjectReference Include="..\Encore.Modules.Notifications\Encore.Modules.Notifications.csproj" />
    <ProjectReference Include="..\Encore.Modules.Orders\Encore.Modules.Orders.csproj" />
    <ProjectReference Include="..\Encore.Modules.Payments\Encore.Modules.Payments.csproj" />
    <ProjectReference Include="..\Encore.Shared\Encore.Shared.csproj" />
    <ProjectReference Include="..\Encore.Telemetry\Encore.Telemetry.csproj" />
  </ItemGroup>

</Project>
