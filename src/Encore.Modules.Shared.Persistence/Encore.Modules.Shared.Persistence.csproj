<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not a module (017): only inert code that names no module or contracts assembly. No
       ProjectReference; modules reference this, never the reverse. -->

  <!-- Hosting abstractions only, not Microsoft.AspNetCore.App: every module references this,
       and Notifications serves no routes. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
