<Project Sdk="Microsoft.NET.Sdk">

  <!-- The startup migrator and Npgsql wiring every module shares. Not a module: the
       architecture tests forbid it to name any module or contracts assembly. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- No ProjectReference: modules reference this, never the reverse, and nothing
       zero-dependency may reach its EF Core. -->

</Project>
