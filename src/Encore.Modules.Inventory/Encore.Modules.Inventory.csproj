<Project Sdk="Microsoft.NET.Sdk">

  <!-- The outside of the hexagon: ports, adapters, and thin use-case
       orchestration. This is the ONLY Inventory project allowed to reference
       infrastructure packages. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The outcome-to-status mapping is an implementation detail of the HTTP
       layer, so it stays internal — but it is also the part most worth testing,
       since it decides ~18 responses and a wrong one is invisible until a client
       hits it. Testing it directly beats standing up a host to infer it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Encore.Modules.Inventory.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Encore.Modules.Inventory.Domain\Encore.Modules.Inventory.Domain.csproj" />
    <ProjectReference Include="..\Encore.Shared\Encore.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.2.1" />
  </ItemGroup>

</Project>
