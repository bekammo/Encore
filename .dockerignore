# Source only. Host bin/ and obj/ are Windows artefacts; in a Linux image they
# restore against the wrong RID and fail in ways that look like code problems.
**/bin/
**/obj/
**/TestResults/
.git/
.vs/
.idea/
.vscode/

# Not source, and no reason to rebuild the image when they change.
*.md

# Except this one: DecisionLogTests read it at run time (020), and without it they
# fail in the container while passing on the host.
!DECISIONS.md
docker-compose.yml
.gitignore
.gitattributes

# Mounted into k6 at run time, never built; its results grow with every run.
load/
