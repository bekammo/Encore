<Project Sdk="Microsoft.NET.Sdk">

  <!-- Architecture rules the build guards cannot reach: module boundaries, nothing
       referencing the host, Domain namespaces. No architecture-test library needed. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Build-order edges only: ReferenceOutputAssembly="false" keeps these outputs off this
       project's compile surface, so the suite never depends on what it inspects. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Encore.Api\Encore.Api.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Shared\Encore.Shared.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Telemetry\Encore.Telemetry.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Catalog\Encore.Modules.Catalog.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Orders\Encore.Modules.Orders.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Notifications\Encore.Modules.Notifications.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Payments\Encore.Modules.Payments.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Inventory\Encore.Modules.Inventory.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Inventory.Domain\Encore.Modules.Inventory.Domain.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Catalog.Contracts\Encore.Modules.Catalog.Contracts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Inventory.Contracts\Encore.Modules.Inventory.Contracts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Encore.Modules.Payments.Contracts\Encore.Modules.Payments.Contracts.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Where to find those outputs, injected at build time. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EncoreRepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EncoreConfiguration</_Parameter1>
      <_Parameter2>$(Configuration)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EncoreTargetFramework</_Parameter1>
      <_Parameter2>$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
