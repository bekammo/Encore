<Project>

  <!-- A project opts in by property, not by name, so a rename cannot silently change what is
       checked:

         EncoreZeroDependency   - all three rules, for projects allowed only the BCL.
         EncoreNoDirectPackages - ENCORE001 only, for hosts: they get ASP.NET Core from the
                                  Web SDK and EF Core through the modules they compose. -->

  <!-- ENCORE001: no direct PackageReference. -->
  <Target Name="EncoreEnforceNoDirectPackages"
          BeforeTargets="CoreCompile"
          Condition="'$(EncoreZeroDependency)' == 'true' or '$(EncoreNoDirectPackages)' == 'true'">
    <Error Condition="@(PackageReference->Count()) &gt; 0"
           Code="ENCORE001"
           Text="$(MSBuildProjectName) must have zero PackageReference items. Found: @(PackageReference->'%(Identity)', ', '). Move the dependency to a project that is allowed packages." />
  </Target>

  <!-- ENCORE002: no FrameworkReference but the implicit Microsoft.NETCore.App. -->
  <Target Name="EncoreEnforceNoFrameworkReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(EncoreZeroDependency)' == 'true'">
    <ItemGroup>
      <_EncoreForbiddenFrameworkReference Include="@(FrameworkReference)"
                                          Condition="'%(Identity)' != 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="'@(_EncoreForbiddenFrameworkReference)' != ''"
           Code="ENCORE002"
           Text="$(MSBuildProjectName) must declare no FrameworkReference other than Microsoft.NETCore.App. Found: @(_EncoreForbiddenFrameworkReference->'%(Identity)', ', '). A framework reference carries a whole platform surface with no PackageReference to show for it, so ENCORE001 cannot see it." />
  </Target>

  <!-- ENCORE003: nothing outside the BCL in the resolved reference closure. BCL assemblies
       carry NuGetPackageId Microsoft.NETCore.App.Ref, packages carry their own id, project
       outputs carry none. The FrameworkReferenceName clause is a backstop for an SDK that
       reports the BCL under another package id. -->
  <Target Name="EncoreEnforceReferenceClosure"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveReferences"
          Condition="'$(EncoreZeroDependency)' == 'true'">
    <ItemGroup>
      <_EncoreForeignReference Include="@(ReferencePath)"
                               Condition="'%(ReferencePath.NuGetPackageId)' != ''
                                      and '%(ReferencePath.NuGetPackageId)' != 'Microsoft.NETCore.App.Ref'
                                      and '%(ReferencePath.FrameworkReferenceName)' != 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="'@(_EncoreForeignReference)' != ''"
           Code="ENCORE003"
           Text="$(MSBuildProjectName) resolves references from outside the BCL: @(_EncoreForeignReference->'%(Filename) [%(NuGetPackageId)]', '; '). This includes anything arriving transitively through a ProjectReference, which is the case ENCORE001 cannot see." />
  </Target>

</Project>
